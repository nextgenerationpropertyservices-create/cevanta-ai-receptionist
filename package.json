{
  "name": "cevanta",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --configLoader native",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-db.mjs",
    "test:db:embedded": "node scripts/test-db-embedded.mjs",
    "test:intake:db": "node scripts/test-intake-embedded.mjs",
    "test:jobs:db": "node scripts/test-jobs-embedded.mjs",
    "test:appointments:db": "node scripts/test-appointments-embedded.mjs",
    "test:onboarding:db": "node scripts/test-onboarding-embedded.mjs",
    "test:provisioning:db": "node scripts/test-workspace-provisioning-embedded.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:db:embedded && pnpm test:intake:db && pnpm test:jobs:db && pnpm test:appointments:db && pnpm test:onboarding:db && pnpm test:onboarding:commands:db && pnpm test:provisioning:db && pnpm test:retell:lead:db && pnpm build",
    "agents:validate": "node scripts/validate-agents.mjs",
    "agents:validate:native": "node scripts/validate-agents.mjs --native",
    "agent": "node scripts/run-agent.mjs",
    "test:onboarding:commands:db": "node scripts/test-onboarding-commands-embedded.mjs",
    "test:retell:lead:db": "node scripts/test-retell-lead-ingestion-embedded.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.57.4",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.0.0",
    "smol-toml": "^1.4.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
